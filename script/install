#!/usr/bin/env bash
#
# Run all dotfiles installers (topic/install.sh).
#
# Only one level deep: submodules and plugin folders (.bash_it, vim/plugged)
# ship their own install.sh files, and bash-it's would replace ~/.bashrc.
# A failing installer is reported but doesn't stop the others.

cd "$(dirname "$0")"/.. || exit 1

failed=""
for installer in */install.sh
do
  [ -f "$installer" ] || continue
  echo "› $installer"
  if ! "./$installer"
  then
    failed="$failed $installer"
  fi
done

if [ -n "$failed" ]
then
  echo "› failed:$failed"
  exit 1
fi
